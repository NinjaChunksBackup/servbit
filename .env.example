# Servbit environment
#
# Only NEXT_PUBLIC_DEFAULT_SITE_URL is read by the application today.
# Everything else is either a Vercel-provided variable or belongs to tooling
# that is documented where it is used.

# Canonical origin. Drives metadataBase, Open Graph URLs, the sitemap, the
# Organization JSON-LD, and the Playwright base URL fallback.
NEXT_PUBLIC_DEFAULT_SITE_URL=http://localhost:3000

# Bundle analysis: npm run build with ANALYZE=true.
# ANALYZE=true

# Preview deployments: VERCEL_ENV=preview makes get-metadata.js build canonical
# URLs from VERCEL_BRANCH_URL. Both are injected by Vercel at runtime.

# Playwright: PLAYWRIGHT_BASE_URL and PLAYWRIGHT_SKIP_WEB_SERVER let the E2E
# suite target an already running server. See tests/critical-flows/README.md.

# Dependency proxy allowlist check: BASE_REF, COOLDOWN_DAYS and DEPS_PROXY_TOKEN
# are read by scripts/check-deps-proxy-allowlisted.mjs.