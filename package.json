{
  "name": "neon-nextjs",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-api-ref.mjs && node src/scripts/update-github-stars.js && node src/scripts/generate-docs-icons-config.js && node src/scripts/generate-static-md-manifest.js && npm run check:content-data && npm run check:pricing-sync && node scripts/docs-checks/neonctl/check-staleness.js",
    "predev": "node scripts/generate-api-ref.mjs && node src/scripts/update-github-stars.js && node src/scripts/generate-docs-icons-config.js && node src/scripts/generate-static-md-manifest.js && npm run check:content-data && npm run check:pricing-sync && node scripts/docs-checks/neonctl/check-staleness.js && npm run generate:ai-gateway-model-markdown && npm run generate:backend-platform-page-markdown",
    "dev": "next dev",
    "build": "next build",
    "dev:build": "next build",
    "postbuild": "node src/scripts/copy-md-content.js && npm run generate:ai-gateway-model-markdown && npm run generate:backend-platform-page-markdown && node src/scripts/generate-llms-index.js && node src/scripts/generate-llms-full.js && next-sitemap --config next-sitemap.config.js && next-sitemap --config next-sitemap-postgres.config.js",
    "start": "next start",
    "fix:md": "prettier --write --log-level warn \"content/**/*.{md,mdx}\"",
    "check:md": "prettier --check --log-level warn \"content/**/*.md\" --ignore-path .prettierignore",
    "fix:js": "eslint --fix --quiet --cache . && prettier --write --log-level warn --cache \"**/*.{js,jsx,css,html}\"",
    "fix:all": "eslint --fix --quiet --cache . && prettier --write --log-level warn --cache .",
    "format:all": "prettier --write --log-level warn --cache .",
    "lint": "npm run lint:js",
    "lint:js": "eslint .",
    "lint:md": "markdownlint --ignore-path .gitignore .",
    "sync:skills": "node src/scripts/sync-skills.js",
    "generate:skills": "node src/scripts/generate-skills-index.js",
    "generate:static-md-manifest": "node src/scripts/generate-static-md-manifest.js",
    "update:skills": "npm run sync:skills && npm run generate:skills && npm run generate:static-md-manifest",
    "generate:api-ref": "node scripts/generate-api-ref.mjs",
    "check:api-ref-generated": "node scripts/check-api-ref-generated.mjs",
    "check:docs-api-consistency": "node scripts/check-docs-api-consistency.mjs",
    "check:skills-sync": "node scripts/check-skills-sync.mjs",
    "check:mcp-categories": "node scripts/check-mcp-categories-sync.mjs",
    "check:mcp-categories:live": "node scripts/check-mcp-categories-sync.mjs --live",
    "audit:api-ref": "node scripts/audit-api-spec.mjs",
    "audit:field-groups": "node scripts/validate-field-groups.mjs",
    "check:broken-links": "linkinator --config linkinator.config.json",
    "check:pricing-sync": "node src/scripts/check-pricing-sync.js",
    "check:models-sync": "node src/scripts/check-models-sync.mjs",
    "check:models-endpoint-sync": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON src/scripts/check-models-endpoint-sync.js",
    "models:import": "node src/scripts/import-models-from-models-dev.mjs",
    "generate:ai-gateway-model-markdown": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON src/scripts/generate-ai-gateway-model-markdown.js",
    "generate:backend-platform-page-markdown": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON src/scripts/generate-backend-platform-page-markdown.js",
    "verify:agent-endpoints": "node scripts/verify-agent-endpoints.mjs",
    "verify:agent-endpoints:live": "node scripts/verify-agent-endpoints.mjs --live",
    "check:content-data": "node scripts/validate-content-data.js",
    "check:deps-proxy": "node scripts/check-deps-proxy-allowlisted.mjs",
    "prepare": "husky",
    "test": "playwright test",
    "test:critical": "playwright test",
    "test:critical:quick": "playwright test --project=desktop-chromium",
    "test:critical:ui": "playwright test --ui",
    "test:critical:report": "playwright show-report",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "check:docs": "vitest run scripts/docs-checks/**/__tests__/*.test.js",
    "cli-docs": "node scripts/docs-checks/neonctl/cli.js"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@inkeep/cxkit-react": "^0.5.119",
    "@next/bundle-analyzer": "16.3.8",
    "@octokit/core": "^7.0.8",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-hook/throttle": "^2.2.0",
    "@rive-app/react-canvas": "^4.36.0",
    "@rive-app/react-webgl2": "4.36.0",
    "@supabase/sql-to-rest": "^0.1.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^2.0.1",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "dotenv": "^18.0.5",
    "framer-motion": "^13.5.0",
    "fuse.js": "^7.5.0",
    "geist": "^1.7.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "html-react-parser": "^6.1.8",
    "js-yaml": "^5.4.2",
    "lodash.shuffle": "^4.2.0",
    "markdownlint-cli": "^0.49.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.3",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "next-mdx-remote": "^6.0.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-medium-image-zoom": "^5.4.9",
    "react-paginate": "^8.3.0",
    "react-share": "^5.3.0",
    "react-tooltip": "^6.0.8",
    "react-use": "^17.6.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "rss": "^1.2.2",
    "slugify": "^1.6.9",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-safe-area": "^1.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vaul": "^1.1.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@neon/sdk": "^7.0.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@scalar/openapi-parser": "^0.29.10",
    "@shikijs/transformers": "^4.5.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/ui": "^5.0.3",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-nesting": "^14.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
