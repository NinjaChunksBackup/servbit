{
  "name": "servbit-nextjs",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "dev:build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "start": "next start",
    "fix:js": "eslint --fix --quiet --cache . && prettier --write --log-level warn --cache \"**/*.{js,jsx,css,html}\"",
    "fix:all": "eslint --fix --quiet --cache . && prettier --write --log-level warn --cache .",
    "format:all": "prettier --write --log-level warn --cache .",
    "lint": "npm run lint:js",
    "lint:js": "eslint .",
    "check:broken-links": "linkinator --config linkinator.config.json",
    "prepare": "husky",
    "test": "playwright test",
    "test:critical": "playwright test",
    "test:critical:quick": "playwright test --project=desktop-chromium",
    "test:critical:ui": "playwright test --ui",
    "test:critical:report": "playwright show-report",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:run": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@headlessui/tailwindcss": "^0.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@next/bundle-analyzer": "16.3.8",
    "@radix-ui/react-toast": "^1.2.23",
    "@rive-app/react-canvas": "^4.36.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "framer-motion": "^13.5.0",
    "geist": "^1.7.2",
    "he": "^1.2.0",
    "js-yaml": "^5.4.2",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-safe-area": "^1.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "linkinator": "^8.1.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-nesting": "^14.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
